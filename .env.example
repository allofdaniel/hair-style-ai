# Google AI Studio API Key (for hair mask generation and analysis)
# Get your API key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Stability AI API Key (for inpainting - hair-only changes)
# Get your API key from: https://platform.stability.ai/account/keys
VITE_STABILITY_API_KEY=your_stability_api_key_here

# Firebase Configuration
# Get these from Firebase Console: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_API_URL=
VITE_N8N_URL=
VITE_REPLICATE_API_URL=

# RevenueCat Configuration
# Get your keys from RevenueCat dashboard: https://app.revenuecat.com/
VITE_REVENUECAT_ANDROID_KEY=your_revenuecat_android_key
VITE_REVENUECAT_IOS_KEY=your_revenuecat_ios_key

# AdMob Configuration
VITE_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
VITE_ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/wwwwwwwwww
VITE_ADMOB_TEST_DEVICE_ID=TEST_DEVICE_ID_1,TEST_DEVICE_ID_2
VITE_AD_TEST_MODE=false

# Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_ENABLE_GA_DEV=false

# Error Tracking
VITE_SENTRY_DSN=
