{
  "name": "beforecut",
  "private": true,
  "version": "1.1.10",
  "description": "AI 헤어스타일 시뮬레이션 - 미용실 가기 전 헤어스타일 미리보기",
  "author": "BeforeCut Team",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate-refs": "tsx scripts/generateReferenceImages.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "android:deploy": "npx tsc -b && vite build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug && cd .. && powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\install-debug-apk.ps1 -WaitForDevice",
    "android:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\install-debug-apk.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-firebase/authentication": "^8.0.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@revenuecat/purchases-capacitor": "^11.3.2",
    "@sentry/react": "^10.32.1",
    "@tailwindcss/vite": "^4.1.17",
    "firebase": "^12.7.0",
    "openai": "^6.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1",
    "vite-plugin-pwa": "^1.2.0",
    "web-vitals": "^5.1.0",
    "workbox-window": "^7.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@supabase/supabase-js": "^2.95.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vercel/node": "^5.5.15",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.22",
    "canvas": "^3.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "form-data": "^4.0.5",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.17",
    "terser": "^5.44.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
